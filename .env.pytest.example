# API
API__HOST=localhost
API__PORT=8888
API__API_KEY=test-secret-api-key-12345
API__RELOAD=false

# Headers
HEADERS__API_KEY=X-API-Key
HEADERS__IDEMPOTENCY_KEY=Idempotency-Key

# Database
DB__HOST=localhost
DB__PORT=5432
DB__USER=payments
DB__PASSWORD=payments
DB__DATABASE=payments_test
DB__ECHO=false

# RabbitMQ
RABBIT__HOST=localhost
RABBIT__PORT=5672
RABBIT__USER=guest
RABBIT__PASSWORD=guest
RABBIT__QUEUE_NAME=payments.new
RABBIT__RETRY_QUEUE_NAME=payments.retry
RABBIT__DLQ_NAME=payments.dlq

# Processing
PROCESSING__MIN_DELAY_SECONDS=0.01
PROCESSING__MAX_DELAY_SECONDS=0.05
PROCESSING__SUCCESS_RATE=1.0
PROCESSING__WEBHOOK_TIMEOUT=2.0
PROCESSING__WEBHOOK_MAX_RETRIES=3
PROCESSING__WEBHOOK_RETRY_BACKOFF=0.01

# Outbox
OUTBOX__POLL_INTERVAL=0.1
OUTBOX__BATCH_SIZE=50
