# Конфигурация API внутри Docker
API__HOST=0.0.0.0
API__PORT=8888
API__RELOAD=false
API__API_KEY=test-secret-api-key-12345

# Конфигурация подключения к БД внутри Docker сети
DB__HOST=postgres
DB__PORT=5432
DB__USER=payments
DB__PASSWORD=payments
DB__DATABASE=payments_db
DB__ECHO=false

# Конфигурация заголовков
HEADERS__API_KEY=X-API-Key
HEADERS__IDEMPOTENCY_KEY=Idempotency-Key

# Конфигурация RabbitMQ
RABBIT__HOST=rabbitmq
RABBIT__PORT=5672
RABBIT__USER=guest
RABBIT__PASSWORD=guest
RABBIT__QUEUE_NAME=payments.new
RABBIT__RETRY_QUEUE_NAME=payments.retry
RABBIT__DLQ_NAME=payments.dlq
RABBIT__DURABLE=true
RABBIT__MAX_RETRIES=3
RABBIT__RETRY_TTL=5000

# Параметры эмуляции процессинга и вебхуков
PROCESSING__MIN_DELAY_SECONDS=2.0
PROCESSING__MAX_DELAY_SECONDS=5.0
PROCESSING__SUCCESS_RATE=0.9
PROCESSING__WEBHOOK_TIMEOUT=5.0
PROCESSING__WEBHOOK_MAX_RETRIES=3
PROCESSING__WEBHOOK_RETRY_BACKOFF=1.0

# Параметры Outbox Relay
OUTBOX__POLL_INTERVAL=1.0
OUTBOX__BATCH_SIZE=50
